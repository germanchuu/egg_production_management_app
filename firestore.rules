rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is admin
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user owns the document (recordedBy/createdBy/preparedBy fields)
    function isOwner(docData) {
      return isAuthenticated()
        && (docData.recordedBy == request.auth.uid
            || docData.createdBy == request.auth.uid
            || docData.preparedBy == request.auth.uid);
    }

    // Check if user is active (not revoked)
    function isActiveUser() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // NOTE: Date fields in this app are stored as ISO-8601 strings (e.g. "2024-01-15"),
    // not as Firestore Timestamps. Client-side Zod validation enforces no-future-date
    // before any record reaches Firestore, so server-side date validation is omitted here.

    // ==================== USERS COLLECTION ====================

    match /users/{userId} {
      // Admins: Full access to all users
      // Users: Read and update own document only (cannot change role)
      allow read: if isAuthenticated()
        && (isAdmin() || request.auth.uid == userId);

      allow create: if isAdmin();

      allow update: if isAuthenticated()
        && (isAdmin()
            || (request.auth.uid == userId
                && request.resource.data.role == resource.data.role)); // Cannot change own role

      allow delete: if isAdmin();
    }

    // ==================== INVITATIONS COLLECTION ====================

    match /invitations/{invitationId} {
      // Public read required: invitation deep links are opened before the user is
      // authenticated (they need to read the invitation to begin the auth flow).
      // Only admins can create/update/delete invitations.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==================== CHICKEN HOUSES COLLECTION ====================

    match /chicken_houses/{houseId} {
      // Admins: Full CRUD access
      // Active users: Read-only
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // ==================== CHICKEN LOTS COLLECTION ====================

    match /chicken_lots/{lotId} {
      // Admins: Full CRUD access
      // Active users: Read-only (lot data is managed by admins)
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // ==================== PRODUCTION RECORDS COLLECTION ====================

    match /production_records/{recordId} {
      // All active users can read all production records (shared farm data)
      // Users can create their own records; admins or owners can update
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.eggsCollected > 0;

      allow update: if isActiveUser()
        && (isAdmin() || isOwner(resource.data))
        && request.resource.data.eggsCollected > 0;

      allow delete: if isAdmin();
    }

    // ==================== MORTALITY RECORDS COLLECTION ====================

    match /mortality_records/{recordId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.hensDied > 0;

      allow update: if isActiveUser()
        && (isAdmin() || isOwner(resource.data))
        && request.resource.data.hensDied > 0;

      allow delete: if isAdmin();
    }

    // ==================== FEED BATCHES COLLECTION ====================

    match /feed_batches/{batchId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.preparedBy == request.auth.uid
        && request.resource.data.quantityKg > 0;

      allow update: if isActiveUser()
        && (isAdmin() || isOwner(resource.data))
        && request.resource.data.quantityKg > 0;

      allow delete: if isAdmin();
    }

    // ==================== FEEDING RECORDS COLLECTION ====================

    match /feeding_records/{recordId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.quantityFedKg > 0;

      allow update: if isActiveUser()
        && (isAdmin() || isOwner(resource.data))
        && request.resource.data.quantityFedKg > 0;

      allow delete: if isAdmin();
    }

    // ==================== HEALTH EVENTS COLLECTION ====================

    match /health_events/{eventId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.eventType == 'vaccination'
        && request.resource.data.productName.size() > 0;

      allow update: if isActiveUser()
        && (isAdmin() || isOwner(resource.data))
        && request.resource.data.eventType == 'vaccination'
        && request.resource.data.productName.size() > 0;

      allow delete: if isAdmin();
    }

    // ==================== BIOSECURITY EVENTS COLLECTION ====================

    match /biosecurity_events/{eventId} {
      allow read: if isActiveUser();

      allow create: if isActiveUser()
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.eventType == 'disinfection'
        && request.resource.data.productName.size() > 0;

      allow update: if isActiveUser()
        && (isAdmin() || isOwner(resource.data))
        && request.resource.data.eventType == 'disinfection'
        && request.resource.data.productName.size() > 0;

      allow delete: if isAdmin();
    }

    // ==================== AUDIT LOGS COLLECTION ====================
    // Collection name: "audit_logs" (plural) — matches SyncService.COLLECTIONS.audit_logs

    match /audit_logs/{auditId} {
      // Only admins can read audit logs (for compliance inspection)
      allow read: if isAdmin();

      // Active users can create audit log entries (written by SyncService on device).
      // Update and delete are denied — audit logs are immutable once created.
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    // ==================== DEFAULT DENY ====================

    // Deny all other collections/documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
