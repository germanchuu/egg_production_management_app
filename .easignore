# EAS Build ignore file
# Similar to .gitignore but for EAS builds
# IMPORTANT: .env.production is NOT ignored here so it gets uploaded to EAS

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
firebase-debug.log

# macOS
.DS_Store
*.pem

# local env files (but NOT .env.production - we need that for builds!)
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code local settings
.claude/settings.local.json

# Vercel hosting (not needed in mobile builds)
vercel-hosting/

# Documentation
FIXES_NEEDED.md
